{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conduit Submission Desk",
  "version": "0.1.0",
  "identifier": "com.capitalinfusion.conduit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Conduit — Submission Desk",
        "width": 1440,
        "height": 980,
        "minWidth": 1280,
        "minHeight": 860,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
