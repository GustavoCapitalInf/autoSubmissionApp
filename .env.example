# conduit-server configuration — copy to .env (server host) or set in your
# platform's secret store. Environment always overrides server.toml.

# Supabase Postgres — Project Settings → Database → Connection string.
# Use the SESSION pooler (port 5432) or direct connection, not the
# transaction pooler (it breaks prepared statements).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage for payload PDFs and seasonality PNGs.
# Project Settings → API: project URL + service_role key (server-side secret).
# Leave unset to store files on the server's local disk instead.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
CONDUIT_STORAGE_BUCKET=conduit-files

# API keys. Generate strong values, e.g. `openssl rand -hex 32`.
# Ingest key: given to the external API that pushes deals. Cannot decide deals.
CONDUIT_INGEST_KEY=
# Desk key: given to Santi's and Careem's desk apps (CONDUIT_DESK_KEY on the
# desk machines, or desk.toml in the app data directory).
CONDUIT_DESK_KEY=

# Networking
CONDUIT_BIND=0.0.0.0
CONDUIT_PORT=4820

# Reviewer-local timezone for decision stamps ("Submitted by Santi · 9:31 AM").
TZ=America/New_York

# Seed the design-handoff demo deals into an EMPTY database (demos only).
SEED_DEMO=false
